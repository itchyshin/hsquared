% Generated by Codex for the experimental automatic FA-rank interface.
\name{hsquared_fa_rank_selection}
\alias{hsquared_fa_rank_selection}
\alias{print.hsquared_fa_rank_selection}
\alias{fit_diagnostics.hsquared_fa_rank_selection}
\title{Experimental automatic factor-analytic rank selection}
\description{
The explicit \code{rank_selection = "auto"} Julia control returns this object
for the bounded comparison of shared-factor counts zero and one.
}
\details{
Inspect \code{candidate_summary} for both requested candidates and
\code{attempts} for actual optimizer starts. The result reports the experimental
REML covariance criterion, selection status and reason, tie and sensitivity
flags, and the uncertainty scope. A successful selection carries an ordinary
\code{hsquared_fit} in \code{selected_fit}; an unavailable or refused result
carries \code{NULL}. The fixed-rank route remains separate. The result does not
promote ordinary factor-analytic formula syntax or a default capability.
}
\value{
An \code{hsquared_fa_rank_selection} object. Its \code{selected_fit} field is an
ordinary \code{hsquared_fit} on success and \code{NULL} otherwise.
}
\seealso{\code{hsquared()}, \code{hs_control()}, \code{fit_diagnostics()}}
